# Copy to .env and adjust values for your environment.
# Every var of the form NIDS_<SECTION>__<KEY> overrides config/config.yaml.

# ─── API ───────────────────────────────────────────────
NIDS_API__HOST=0.0.0.0
NIDS_API__PORT=8000
# Leave API_KEY empty to disable auth. Generate one: `openssl rand -hex 32`
NIDS_API__API_KEY=
NIDS_API__RATE_LIMIT_PER_MINUTE=240

# ─── Data / training ──────────────────────────────────
NIDS_DATA__N_SAMPLES=50000
NIDS_DATA__RANDOM_STATE=42

# ─── Logging ──────────────────────────────────────────
NIDS_LOGGING__LEVEL=INFO

# ─── docker-compose extras ────────────────────────────
GRAFANA_PASSWORD=admin
N_SAMPLES=20000
