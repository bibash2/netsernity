# Copy to .env and adjust values for your environment.
# Every var of the form NETSENTRY_<SECTION>__<KEY> overrides config/config.yaml.

# ─── API ───────────────────────────────────────────────
NETSENTRY_API__HOST=0.0.0.0
NETSENTRY_API__PORT=8000
# Leave API_KEY empty to disable auth. Generate one: `openssl rand -hex 32`
NETSENTRY_API__API_KEY=
NETSENTRY_API__RATE_LIMIT_PER_MINUTE=240

# ─── Data / training ──────────────────────────────────
NETSENTRY_DATA__N_SAMPLES=50000
NETSENTRY_DATA__RANDOM_STATE=42

# ─── Logging ──────────────────────────────────────────
NETSENTRY_LOGGING__LEVEL=INFO

# ─── docker-compose extras ────────────────────────────
GRAFANA_PASSWORD=admin
N_SAMPLES=20000
